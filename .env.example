MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_career_demo
# Set these only when running npm run bootstrap:production on a fresh database.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5173
SESSION_SECRET=replace-with-a-long-random-secret
# Optional: enable explicit-consent AI suggestions (server only, never VITE_)
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=
# Email OTP: create/verify a sender domain and API key with Resend.
EMAIL_VERIFICATION_REQUIRED=0
RESEND_API_KEY=
EMAIL_FROM=Portfolio FPT Hub <no-reply@example.com>
OTP_SECRET=replace-with-a-different-long-random-secret
# PayOS: create and verify a payment channel before enabling checkout.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=https://your-site.example/payment/return
PAYOS_CANCEL_URL=https://your-site.example/payment/cancel
# Manual VietQR is the default. The public receiving details below match
# shared/paymentAccount.js; override all of them here if the owner changes.
PAYMENT_PROVIDER=manual
PAYMENT_BANK=970423
PAYMENT_BANK_NAME=TPBank
PAYMENT_ACCOUNT=33313052004
PAYMENT_ACCOUNT_NAME=NGUYEN SY HUY
VITE_API_URL=http://127.0.0.1:4000
# Relative assets support both the project URL and portfolio.id.vn.
VITE_BASE_PATH=./
